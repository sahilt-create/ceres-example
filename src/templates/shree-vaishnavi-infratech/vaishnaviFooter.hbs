<footer class="{{#unless mapped.visibility.footerOnLastPage}}no-dibella {{/unless}}invoice-letterhead-footer template-footer{{#if isPageFixed}} page-footer-fixed{{/if}}{{#unless display.assets.letterHeadFooter}} is-empty{{/unless}}" data-ceres-page-footer data-ceres-page-policy="all">
    {{#if display.assets.letterHeadFooter}}<img src="{{display.assets.letterHeadFooter}}" alt="Letterhead footer" data-ceres-height="letterhead-footer" referrerpolicy="no-referrer" />{{else}}<img alt="Letterhead footer" data-ceres-height="letterhead-footer" />{{/if}}
    <span class="ceres-page-numbering">Page <span data-ceres-page-number></span> of <span data-ceres-page-total></span></span>
  </footer>
