{{!--
  Classic Template (Figma Document-Templates, node 1801:8109 "Classic Template").

  Root is normalizeInvoiceTemplateState's output. Every block reads the view model built once
  by `clView` (helpers.ts): labels, visibility and table columns all come from the payload.
  The design has no fixed assets: the logo, the QR codes and the signature are the document's.

  Order: header (title + status | document details, business logo + document QR), Billed By |
  Billed To, Shipped From | Shipped To, Transport Details | E-Invoice / E-Way Bill (with the
  e-invoice QR), items (with the column-sum row), then two columns: Bank and UPI, Terms, Notes,
  Additional Info, Attachments on the left; totals, amount in words and signature on the
  right. Summaries (HSN, tax, batch, payments) and the enquiry line close the document.
  data-testid / data-section / data-col are test hooks; data-ceres-* are the host's live
  update targets.
--}}
{{#with (clView @root) as |view|}}
<div class="cl-doc{{#if view.print.stretchTable}} is-stretch{{/if}}{{#if view.pageless}} is-pageless{{/if}}" data-cl-currency="{{@root.invoice.currency}}" data-testid="invoice-root" data-cl-side-margin="{{view.print.sideMargin}}" data-cl-paper-width="{{view.print.paperWidth}}" dir="{{view.script.dir}}"{{#if view.script.lang}} lang="{{view.script.lang}}"{{/if}}{{#if view.script.script}} data-ceres-script="{{view.script.script}}"{{/if}} style="--cl-text-scale: {{view.print.textScale}}; --cl-print-scale: {{view.print.printScale}}; --cl-print-width: {{view.print.printWidth}}px; --cl-browser-print-width: {{view.print.browserPrintWidth}}px; --cl-print-base: {{view.print.printBase}}px; --cl-browser-print-height: {{view.print.browserPrintHeight}}px; --cl-browser-print-base: {{view.print.browserPrintBase}}px;{{#if view.theme}} --cl-theme: {{view.theme.accent}}; --cl-on-accent: {{view.theme.onAccent}};{{#if view.theme.accentText}} --cl-accent-text: {{view.theme.accentText}};{{/if}}{{/if}}{{#if view.script.font}} --cl-script-font: {{{view.script.font}}};{{/if}}">
  {{!-- Text Scale Smaller (0.8, also unset): Refrens' renderer leaves the page unzoomed then, so the template zooms it (helpers.ts mapPrint ownPrintZoom); :where() lets the renderer's own rule win once Lydia sets another size live. --}}
  {{#if view.print.ownPrintZoom}}<style id="cl-own-zoom">@media print { :where(html) { zoom: {{view.print.ownPrintZoom}}; } }</style>{{/if}}
  {{!-- The Language/Script setting's font, for the glyphs Inter lacks. --}}
  {{#if view.script.fontUrl}}<link rel="stylesheet" href="{{view.script.fontUrl}}" />{{/if}}
  {{#unless view.letterheadEveryPage}}
    {{!-- Letterhead on the first page only (pdfOptions.letterHeadOnFirstPage): in the flow. --}}
    <div class="{{#if view.serviceLetterhead}}no-dibella {{/if}}invoice-letterhead cl-letterhead{{#unless @root.invoice.letterHead}} is-empty{{/unless}}" data-ceres-page-header data-ceres-page-policy="first">
      {{#if @root.invoice.letterHead}}
        <img src="{{@root.invoice.letterHead}}" alt="Letterhead" data-ceres-height="letterhead" />
      {{else}}
        <img alt="Letterhead" data-ceres-height="letterhead" />
      {{/if}}
    </div>
  {{/unless}}

  {{!--
    Print frame: transparent on screen (display: contents). In print, the letterhead repeats
    at the top of every page in the <thead> unless it is for the first page only; when the
    footer repeats on every page (pdfOptions.footerOnLastPage off), the real footer is fixed
    to the foot of each page and the repeating <tfoot> holds an invisible copy of it, so
    content never runs under it.
  --}}
  <table class="cl-page-frame" role="presentation">
    {{!-- The page's top margin in a browser's own print, whose page margins are 0 there so Chrome
          prints no date / title / URL / page-number stamps (helpers.ts applyBrowserPrintPage);
          hidden otherwise, and under an every-page letterhead, which sits on the page's edge. --}}
    <thead class="cl-page-frame-header">
      <tr class="cl-page-margin" aria-hidden="true"><td></td></tr>
      {{#if view.letterheadEveryPage}}
        {{!-- What the PDF service's stamped letterhead takes past its margin (helpers.ts placeStampRoom). --}}
        <tr class="cl-stamp-room is-top" aria-hidden="true"><td></td></tr>
        <tr>
          <td>
            <div class="no-dibella invoice-letterhead cl-letterhead{{#unless @root.invoice.letterHead}} is-empty{{/unless}}" data-ceres-page-header data-ceres-page-policy="all">
              {{#if @root.invoice.letterHead}}
                <img src="{{@root.invoice.letterHead}}" alt="Letterhead" data-ceres-height="letterhead" />
              {{else}}
                <img alt="Letterhead" data-ceres-height="letterhead" />
              {{/if}}
            </div>
          </td>
        </tr>
      {{/if}}
    </thead>
    <tfoot class="cl-page-frame-footer">
      {{#if view.footerEveryPage}}
        <tr>
          <td>
            <div class="{{#if view.serviceFooter}}no-dibella {{/if}}invoice-letterhead-footer cl-letterhead-footer cl-footer-spacer{{#unless @root.invoice.letterHeadFooter}} is-empty{{/unless}}" aria-hidden="true">
              {{#if @root.invoice.letterHeadFooter}}<img src="{{@root.invoice.letterHeadFooter}}" alt="" />{{else}}<img alt="" />{{/if}}
            </div>
          </td>
        </tr>
        <tr class="cl-stamp-room is-bottom" aria-hidden="true"><td></td></tr>
      {{/if}}
      {{#if view.ownSignatureNote}}
        <tr class="cl-signature-note"><td><p>This is an electronically generated document, no signature is required.</p></td></tr>
      {{/if}}
      <tr class="cl-page-margin" aria-hidden="true"><td></td></tr>
    </tfoot>
    <tbody>
      <tr>
        <td class="cl-page-frame-cell">
          <div class="cl-page-body">
          {{!--
            The band (Classic design, user's mock 2026-11-05): everything above the items on the
            theme colour, laid out as Refrens' own Classic template places the fields: the title,
            then the logo on a white tile | the seller | Billed To, then the document details
            between two rules (Country / Place of Supply among them, the document QR on the right),
            then Shipped From | Shipped To | Transport Details | E-Invoice. Each row prints whole.
          --}}
          {{!--
            Header (Refrens' Classic, user's "Classic - Web View" PDF 2026-11-19): the logo on the
            left; the title with its status tag, the subtitle and the business address on the right.
            Then Billed By | Billed To | <Document> Details, then Shipped From | Shipped To |
            Transport Details, three columns each. Each row prints whole.
          --}}
          <header class="cl-band" data-testid="section" data-section="header">
            <div class="cl-band-row cl-title-block{{#unless view.brand.logo}} has-no-logo{{/unless}}">
              {{#if view.brand.logo}}
                <div class="cl-logo">
                  {{> CeresImage src=view.brand.logo alt=view.brand.name class="cl-logo-image"}}
                </div>
              {{/if}}
              <div class="cl-title-side">
                {{#if view.title}}
                  <div class="cl-title-row">
                    <h1 class="cl-title" data-role="title">{{view.title}}</h1>
                    {{#if view.status}}
                      <span class="cl-status{{#unless view.status.inPrint}} no-print{{/unless}}"><span class="invoice-tag {{view.status.color}}">{{view.status.text}}</span></span>
                    {{/if}}
                  </div>
                {{/if}}
                {{#if view.subtitle}}<p class="cl-subtitle">{{view.subtitle}}</p>{{/if}}
                {{#if view.copy}}<p class="cl-copy" data-role="tag">{{view.copy}}</p>{{/if}}
                {{!-- Under the title the subtitle only, no business address (user, 2026-11-25; Refrens' native Classic). --}}
              </div>
            </div>

            <div class="cl-band-row cl-band-parties" data-testid="section" data-section="parties">
              {{#each view.parties}}
                <div class="cl-party cl-{{role}}" data-role="{{role}}">
                  {{#if title}}<h2 class="cl-band-caption">{{title}}</h2>{{/if}}
                  <p class="cl-party-name" dir="auto">{{name}}</p>
                  {{#if address}}<p class="cl-party-address" data-role="address">{{address}}</p>{{/if}}
                  {{#if fields.length}}
                    <div class="cl-fields">
                      {{#each fields}}
                        <p class="cl-field"><span class="cl-field-label">{{label}}</span><span class="cl-field-value{{#if noWrap}} cl-num{{else if isEmail}} cl-email{{/if}}{{#if isToken}} cl-break{{/if}}">{{#if isDate}}{{clDate value @root.invoice.ownerOffset}}{{else if isPhone}}{{formatPhoneNumber value}}{{else}}{{value}}{{/if}}</span></p>
                      {{/each}}
                    </div>
                  {{/if}}
                </div>
              {{/each}}
              {{#if view.hasDetailsRow}}
                <div class="cl-party cl-doc-details" data-testid="section" data-section="details">
                  {{!-- No "<Document> Details" heading over the details (user, 2026-11-25; classic.pdf has none). --}}
                  <div class="cl-fields cl-meta-list">
                    {{#each view.details}}
                      <p class="cl-field cl-detail cl-meta-{{key}}"{{#if attr}} {{attr}}{{/if}}{{#if isHidden}} style="display:none"{{/if}}><span class="cl-field-label cl-detail-label">{{label}}</span><span class="cl-field-value cl-detail-value{{#if isNum}} cl-num{{/if}}"{{#if isNum}} data-testid="num"{{/if}}>{{#if isDate}}{{clDate value @root.invoice.ownerOffset}}{{else if isUtcDate}}{{clDate value 0}}{{else}}{{value}}{{/if}}</span></p>
                    {{/each}}
                    {{!-- IRN, Ack No. / Date and the e-way bill after the dates; the IRN wraps. --}}
                    {{#unless view.compliance.isBelowItems}}
                      <div class="cl-compliance cl-details-compliance" data-testid="section" data-section="compliance">
                        {{#if view.compliance.showIrn}}
                          <p class="cl-field cl-detail cl-irn-row"{{#unless view.compliance.irn}} style="display:none"{{/unless}}><span class="cl-field-label cl-detail-label">{{view.compliance.irnLabel}}</span><span class="cl-field-value cl-detail-value cl-irn-value cl-break" data-ceres-field="irn">{{view.compliance.irn}}</span></p>
                        {{/if}}
                        {{#each view.compliance.rows}}
                          <p class="cl-field cl-detail cl-compliance-{{key}}"><span class="cl-field-label cl-detail-label">{{label}}</span><span class="cl-field-value cl-detail-value cl-num" data-testid="num">{{#if isDate}}{{clDate value @root.invoice.ownerOffset}}{{else if isUtcDate}}{{clDate value 0}}{{else}}{{value}}{{/if}}</span></p>
                        {{/each}}
                      </div>
                    {{/unless}}
                    {{#if view.supply}}
                      <div class="cl-supply" data-testid="section" data-section="supply" data-ceres-country-of-supply{{#if view.supply.hidden}} style="display:none"{{/if}}>
                        {{#each view.supply.rows}}
                          <p class="cl-field cl-detail cl-supply-cell"{{#if attr}} {{attr}}{{/if}}{{#if isHidden}} style="display:none"{{/if}}><span class="cl-field-label cl-detail-label">{{label}}</span><span class="cl-field-value cl-detail-value">{{value}}</span></p>
                        {{/each}}
                      </div>
                    {{/if}}
                  </div>
                  {{!-- One QR under the details: the e-invoice QR while the IRN is active, else the
                        document QR (standing rule); ZATCA / LHDN beside it. --}}
                  <div class="cl-qr-list cl-details-qrs">
                    <div class="cl-qr cl-doc-qr{{#unless view.documentQr}} is-empty{{/unless}}" data-ceres-field-container="documentQr"><img data-ceres-field="documentQr"{{#if view.documentQr}} src="{{view.documentQr}}"{{/if}} alt="Document QR Code" /></div>
                    {{#unless view.compliance.isBelowItems}}
                      <div class="cl-qr{{#unless view.compliance.qr.irn}} is-empty{{/unless}}" data-ceres-field-container="qrCode"><img data-ceres-field="qrCode"{{#if view.compliance.qr.irn}} src="{{view.compliance.qr.irn}}"{{/if}} alt="E-Invoice QR Code" /></div>
                      <div class="cl-qr{{#unless view.compliance.qr.zatca}} is-empty{{/unless}}" data-ceres-field-container="zatcaQrCode"><img data-ceres-field="zatcaQrCode"{{#if view.compliance.qr.zatca}} src="{{view.compliance.qr.zatca}}"{{/if}} alt="ZATCA QR Code" /></div>
                      <div class="cl-qr{{#unless view.compliance.qr.lhdn}} is-empty{{/unless}}" data-ceres-field-container="lhdnQrCode"><img data-ceres-field="lhdnQrCode"{{#if view.compliance.qr.lhdn}} src="{{view.compliance.qr.lhdn}}"{{/if}} alt="LHDN QR Code" /></div>
                    {{/unless}}
                  </div>
                </div>
              {{/if}}
            </div>

            {{!-- Shipped From | Shipped To | Transport Details: each takes the next column, no gap
                  where one is missing. The IRN and e-way bill sit among the details above. --}}
            <div class="cl-band-row cl-band-logistics" data-testid="section" data-section="logistics">
              {{#each view.dispatchParties}}
                <div class="cl-party cl-ship" data-role="{{role}}">
                  {{#if title}}<h2 class="cl-band-caption">{{title}}</h2>{{/if}}
                  <p class="cl-party-name" dir="auto">{{name}}</p>
                  {{#if address}}<p class="cl-party-address" data-role="address">{{address}}</p>{{/if}}
                  {{#if fields.length}}
                    <div class="cl-fields">
                      {{#each fields}}
                        <p class="cl-field"><span class="cl-field-label">{{label}}</span><span class="cl-field-value{{#if noWrap}} cl-num{{else if isEmail}} cl-email{{/if}}{{#if isToken}} cl-break{{/if}}">{{#if isDate}}{{clDate value @root.invoice.ownerOffset}}{{else if isPhone}}{{formatPhoneNumber value}}{{else}}{{value}}{{/if}}</span></p>
                      {{/each}}
                    </div>
                  {{/if}}
                </div>
              {{/each}}
              {{#if view.transport}}
                <div class="cl-party cl-transport" data-role="transport">
                  {{#if view.transport.title}}<h2 class="cl-band-caption">{{view.transport.title}}</h2>{{/if}}
                  <div class="cl-fields">
                    {{#each view.transport.rows}}
                      <p class="cl-field"><span class="cl-field-label cl-transport-{{key}}">{{label}}</span><span class="cl-field-value{{#if isNum}} cl-num{{/if}}"{{#if isNum}} data-testid="num"{{/if}}>{{#if isDate}}{{clDate value @root.invoice.ownerOffset}}{{else if isUtcDate}}{{clDate value 0}}{{else}}{{value}}{{/if}}</span></p>
                    {{/each}}
                  </div>
                </div>
              {{/if}}
            </div>
          </header>

          <section class="cl-items-section" data-testid="section" data-section="items">
            <div class="cl-items-scroll" data-testid="items-scroll">
              <table class="cl-items{{#if view.printTight}} is-print-tight{{/if}}{{#if view.table.showThumbnail}} has-thumbnails{{/if}}{{#if view.table.smallNumbers}} has-small-numbers{{/if}}{{#if view.table.manyFigures}} has-many-figures{{/if}}" data-testid="items-table" style="--cl-figures: {{view.table.figureCount}}; --cl-serial-width: {{view.table.serialWidth}}px;">
                <thead>
                  <tr data-testid="items-header">
                    <th class="cl-col-serial" data-col="sr" style="width: {{view.table.serialWidth}}px">{{view.table.serialLabel}}</th>
                    {{#each view.table.header}}
                      <th class="{{className}}" data-col="{{col}}"{{#if width}} style="width: {{width}}px"{{/if}}>
                        {{#if isName}}<span class="cl-desc-min" aria-hidden="true" style="width: {{view.table.descriptionMin}}px"></span>{{/if}}
                        {{#each labelParts}}{{this}}{{#unless @last}}<wbr />{{/unless}}{{/each}}
                      </th>
                    {{/each}}
                  </tr>
                </thead>
                <tbody>
                  {{#each view.table.rows}}
                    {{#if isGroupHeader}}
                      <tr class="cl-group-row{{#if isStripe}} is-stripe{{/if}}" data-testid="group-row">
                        <td colspan="{{colspan}}">
                          <span class="cl-group-name">{{name}}</span>
                          {{#if images.length}}{{> CeresImageGallery (prepareImageGallery images variant="thumbnail" alt=name) }}{{/if}}
                        </td>
                      </tr>
                      {{#if originalImages.length}}
                        <tr class="cl-image-row cl-group-image-row{{#if isStripe}} is-stripe{{/if}}" data-testid="group-image-row">
                          <td colspan="{{colspan}}">
                            {{#each originalImages}}<img class="cl-large-image" data-testid="large-image" src="{{this}}" alt="{{../name}}" referrerpolicy="no-referrer" />{{/each}}
                          </td>
                        </tr>
                      {{/if}}
                    {{else}}
                      {{#if nameRow}}
                        <tr class="cl-name-row{{#if isStripe}} is-stripe{{/if}}" data-testid="item-name-row" data-item-index="{{itemIndex}}">
                          <td class="cl-col-serial" data-col="sr" rowspan="2">{{#if serial}}<span class="cl-num" data-testid="num">{{serial}}</span>{{/if}}</td>
                          <td colspan="{{detailColspan}}">
                            <span class="cl-item-name">{{name}}</span>
                            {{#if inlineCodes.length}}<span class="cl-item-codes">{{#each inlineCodes}}<span class="cl-item-code">{{this}}</span>{{/each}}</span>{{/if}}
                          </td>
                        </tr>
                      {{/if}}
                      <tr class="cl-item-row{{#if isStripe}} is-stripe{{/if}}{{#if isRich}} is-rich{{/if}}{{#if isGroupTotal}} cl-group-total-row{{/if}}{{#if nameRow}} has-name-row{{/if}}" data-testid="item-row" data-item-index="{{itemIndex}}">
                        {{#unless nameRow}}<td class="cl-col-serial" data-col="sr">{{#if serial}}<span class="cl-num" data-testid="num">{{serial}}</span>{{/if}}</td>{{/unless}}
                        {{#each cells}}
                          {{#if isName}}
                            <td class="{{className}}" data-col="{{col}}">
                              {{#if ../thumbnail}}
                                <div class="cl-item-thumbnail">{{> CeresImage src=../thumbnail alt=../name class="cl-thumbnail" href=../thumbnail}}</div>
                              {{/if}}
                              {{#unless ../nameRow}}
                                <span class="cl-item-name">{{../name}}</span>
                                {{#if ../inlineCodes.length}}<span class="cl-item-codes">{{#each ../inlineCodes}}<span class="cl-item-code">{{this}}</span>{{/each}}</span>{{/if}}
                              {{/unless}}
                              {{#if ../hasDetail}}
                                <div class="cl-item-detail" data-ceres-description-inline{{#if ../detailRow}} style="display: none;"{{/if}}>
                                  {{#unless ../detailRow}}
                                    <div data-ceres-description-content>
                                      {{#if ../description}}<div class="cl-item-desc">{{> MarkdownViewer (prepareMarkdownViewerData ../description) }}</div>{{/if}}
                                      {{#if ../images.length}}{{> CeresImageGallery (prepareImageGallery ../images variant="thumbnail" alt=../name) }}{{/if}}
                                    </div>
                                  {{/unless}}
                                </div>
                              {{/if}}
                              {{!-- Original images inside the item's cell, under its description, as
                                    Refrens' native Classic places them (186 px wide). --}}
                              {{#if ../originalImages.length}}
                                <div class="cl-item-originals">{{#each ../originalImages}}<img class="cl-large-image" data-testid="large-image" src="{{this}}" alt="{{../../name}}" referrerpolicy="no-referrer" />{{/each}}</div>
                              {{/if}}
                            </td>
                          {{else}}
                            <td class="{{className}}" data-col="{{col}}" data-label="{{label}}">{{#if isNum}}<span class="cl-num" data-testid="num">{{value}}</span>{{else}}{{value}}{{/if}}</td>
                          {{/if}}
                        {{/each}}
                      </tr>
                      {{#if hasDetail}}
                        {{!-- Full-width description row (isDescriptionFullWidth), kept for the live toggle. --}}
                        <tr class="cl-detail-row{{#if isStripe}} is-stripe{{/if}}" data-testid="item-detail-row" data-item-index="{{itemIndex}}" data-ceres-description-row{{#unless detailRow}} style="display: none;"{{/unless}}>
                          <td class="cl-col-serial"></td>
                          <td colspan="{{detailColspan}}">
                            <div class="cl-item-detail" data-ceres-description-full-width>
                              {{#if detailRow}}
                                <div data-ceres-description-content>
                                  {{#if description}}<div class="cl-item-desc">{{> MarkdownViewer (prepareMarkdownViewerData description) }}</div>{{/if}}
                                  {{#if images.length}}{{> CeresImageGallery (prepareImageGallery images variant="thumbnail" alt=name) }}{{/if}}
                                </div>
                              {{/if}}
                            </div>
                          </td>
                        </tr>
                      {{/if}}
                    {{/if}}
                  {{/each}}
                  {{!-- Stretch row: takes the spare height of a one-page printout, or of the preview's A4 sheet. --}}
                  <tr class="cl-filler" aria-hidden="true"><td class="cl-col-serial"></td>{{#each view.table.header}}<td class="{{className}}"></td>{{/each}}</tr>
                </tbody>
                {{#if view.table.footer.show}}
                  <tbody class="cl-items-total">
                    <tr class="cl-total-row" data-testid="items-total">
                      <td class="cl-col-serial" data-col="sr">{{#if view.table.footer.labelInSerial}}{{view.table.footer.label}}{{/if}}</td>
                      {{#each view.table.footer.cells}}
                        <td class="{{className}}" data-col="{{col}}"{{#unless isName}} data-label="{{label}}"{{/unless}}>{{#if isName}}{{view.table.footer.label}}{{else if isNum}}<span class="cl-num" data-testid="num">{{value}}</span>{{/if}}</td>
                      {{/each}}
                    </tr>
                  </tbody>
                {{/if}}
                {{!-- Print only: repeated at the foot of each page the table spans, it rounds the
                      corners of the page's last row (styles.css, "corners at a page break"). --}}
                <tfoot class="cl-items-corners" aria-hidden="true">
                  <tr><td class="cl-col-serial"></td>{{#each view.table.header}}<td class="{{className}}"></td>{{/each}}</tr>
                </tfoot>
              </table>
            </div>
          </section>

          {{#if view.compliance.isBelowItems}}
            <section class="cl-cards cl-logistics" data-testid="section" data-section="logistics-below">
              <div class="cl-card cl-compliance cl-col-2{{#unless view.hasCompliance}} is-empty{{/unless}}" data-testid="section" data-section="compliance">
                <div class="cl-compliance-text">
                  {{#if view.compliance.title}}<h2 class="cl-card-title">{{view.compliance.title}}</h2>{{/if}}
                  <div class="cl-kv">
                    {{#if view.compliance.showIrn}}
                      <span class="cl-kv-label cl-irn-row"{{#unless view.compliance.irn}} style="display:none"{{/unless}}>{{view.compliance.irnLabel}}</span>
                      <span class="cl-kv-value cl-irn-value"{{#unless view.compliance.irn}} style="display:none"{{/unless}} data-ceres-field="irn">{{view.compliance.irn}}</span>
                    {{/if}}
                    {{#each view.compliance.rows}}
                      <span class="cl-kv-label">{{label}}</span>
                      <span class="cl-kv-value cl-num" data-testid="num">{{#if isDate}}{{clDate value @root.invoice.ownerOffset}}{{else if isUtcDate}}{{clDate value 0}}{{else}}{{value}}{{/if}}</span>
                    {{/each}}
                  </div>
                </div>
                <div class="cl-qr-list">
                  <div class="cl-qr{{#unless view.compliance.qr.irn}} is-empty{{/unless}}" data-ceres-field-container="qrCode"><img data-ceres-field="qrCode"{{#if view.compliance.qr.irn}} src="{{view.compliance.qr.irn}}"{{/if}} alt="E-Invoice QR Code" /></div>
                  <div class="cl-qr{{#unless view.compliance.qr.zatca}} is-empty{{/unless}}" data-ceres-field-container="zatcaQrCode"><img data-ceres-field="zatcaQrCode"{{#if view.compliance.qr.zatca}} src="{{view.compliance.qr.zatca}}"{{/if}} alt="ZATCA QR Code" /></div>
                  <div class="cl-qr{{#unless view.compliance.qr.lhdn}} is-empty{{/unless}}" data-ceres-field-container="lhdnQrCode"><img data-ceres-field="lhdnQrCode"{{#if view.compliance.qr.lhdn}} src="{{view.compliance.qr.lhdn}}"{{/if}} alt="LHDN QR Code" /></div>
                </div>
              </div>
            </section>
          {{/if}}

          <div class="cl-bottom">
            <div class="cl-bottom-main">
              {{!-- Left column beside the totals (Refrens' native Classic): Terms and Notes;
                    Attachments and Additional Information follow the bank details. --}}

              {{#each view.terms}}
                <section class="cl-card cl-terms" data-testid="section" data-section="terms">
                  <h2 class="cl-card-title" data-role="title">{{title}}</h2>
                  <ol class="cl-terms-list">
                    {{#each items}}<li>{{this}}</li>{{/each}}
                  </ol>
                </section>
              {{/each}}

              {{#if view.notes}}
                <section class="cl-card cl-notes" data-testid="section" data-section="notes">
                  {{#if view.notes.title}}<h2 class="cl-card-title" data-role="title">{{view.notes.title}}</h2>{{/if}}
                  <div class="cl-note-body">{{> MarkdownViewer (prepareMarkdownViewerData view.notes.body) }}</div>
                </section>
              {{/if}}

            </div>

            <div class="cl-bottom-side">
              {{!--
                The totals: the shared Subtotal widget's rows (computeSubtotalRows) with its classes
                and data-ceres-* hooks, so the live hideTotals / hideTaxes toggles and the widget's
                visibility CSS still apply. The grand total reads large between two rules.
              --}}
              <table class="cl-totals-table" data-testid="totals-table">
                <tbody class="cl-totals ceres-subtotal" data-ceres-subtotal data-testid="section" data-section="totals">
                  {{#each view.totals.rows}}
                    <tr
                      class="ceres-subtotal-row ceres-subtotal-row-{{emphasis}}{{#if isGrand}} cl-grand-row{{/if}}{{#if isExtra}} cl-extra-row{{/if}}{{#if view.totals.hidden}}{{#unless survivesHideTotals}} is-hidden-by-totals{{/unless}}{{/if}}{{#if isTaxRow}}{{#if view.totals.hideTaxes}} is-hidden-by-taxes{{/if}}{{/if}}"
                      data-ceres-subtotal-row="{{key}}"
                      {{#if isTaxRow}}data-ceres-subtotal-taxes{{/if}}
                      {{#if survivesHideTotals}}data-ceres-subtotal-keep{{/if}}
                    >
                      <th class="ceres-subtotal-label" scope="row">
                        {{label}}
                        {{#if note}}<div class="ceres-subtotal-note">{{note}}</div>{{/if}}
                      </th>
                      <td class="ceres-subtotal-value">
                        <span class="cl-num"{{#if isNum}} data-testid="num"{{/if}}{{#if isGrand}} data-role="grand-total-row"{{/if}}>{{value}}</span>
                        {{#if converted}}<div class="ceres-subtotal-converted">{{converted}}</div>{{/if}}
                        {{#if extra}}
                          <div class="ceres-subtotal-extra">
                            {{extra.value}}
                            {{#if extra.converted}}<div class="ceres-subtotal-converted">{{extra.converted}}</div>{{/if}}
                          </div>
                        {{/if}}
                      </td>
                    </tr>
                  {{/each}}
                </tbody>
              </table>

              {{!-- The amount in words under the grand total, its title a coloured caption (Classic
                    design; Refrens' Classic places it there too). --}}
              {{#if view.words}}
                <div class="cl-words ceres-subtotal-words{{#if view.totals.hidden}} is-hidden-by-totals{{/if}}{{#if view.words.hiddenBySetting}} is-hidden-by-words-setting{{/if}}" data-ceres-total-in-words>
                  <h2 class="cl-section-title cl-words-label">{{view.words.label}}</h2>
                  <p class="cl-words-value">{{view.words.value}}</p>
                </div>
              {{/if}}

              {{!-- Only for a signature the document has (an image or a digital request); no
                    "For <business>" line, as refrens.com prints it. --}}
              {{#if view.signature.show}}
                <section class="cl-signature" data-testid="signature">
                  <div class="cl-signature-mark">
                    {{#if view.signature.image}}
                      {{> CeresImage src=view.signature.image alt=view.signature.label class="cl-signature-image"}}
                    {{else if view.signature.awaitingDigital}}
                      <p class="cl-signature-banner">Awaiting Digital Signature</p>
                    {{else if view.signature.signedDigital}}
                      <p class="cl-signature-banner">
                        Digitally signed{{#if view.signature.signerName}} by {{view.signature.signerName}}{{/if}}
                        {{#if view.signature.verifyUrl}}<a href="{{view.signature.verifyUrl}}" target="_blank" rel="noopener noreferrer">Verify</a>{{/if}}
                      </p>
                    {{/if}}
                  </div>
                  {{!-- Under the signature: "For <business>" (Refrens' native Classic prints no "Authorised Signatory"). --}}
                  {{#if view.signature.forLine}}<p class="cl-signature-for">{{view.signature.forLine}}</p>{{/if}}
                </section>
              {{/if}}
            </div>
          </div>

          {{!-- Bank and UPI details in a row of their own under terms | totals (Refrens' native
                Classic, invoice 0029). --}}
          <div class="cl-bank-part">
          {{#if view.bank.show}}
            <section class="cl-card cl-bank" data-testid="section" data-section="bank">
              <div class="cl-bank-main">
                {{#if view.bank.title}}<h2 class="cl-card-title" data-role="title">{{view.bank.title}}</h2>{{/if}}
                <div class="cl-kv cl-bank-rows">
                  {{#each view.bank.rows}}
                    <span class="cl-kv-label cl-bank-{{key}}">{{label}}</span>
                    <span class="cl-kv-value{{#if isNum}} cl-num{{/if}}"{{#if isNum}} data-testid="num"{{/if}}>{{value}}</span>
                  {{/each}}
                  {{!-- The UPI ID prints once, as refrens.com prints it: under the QR when there
                        is one, else here with the bank rows. --}}
                  {{#if view.bank.upi}}{{#unless view.bank.upi.qr}}
                    <span class="cl-kv-label cl-bank-upi">{{view.bank.upi.label}}</span>
                    <span class="cl-kv-value cl-num" data-testid="num">{{view.bank.upi.id}}</span>
                  {{/unless}}{{/if}}
                </div>
              </div>
              {{#if view.bank.upi.qr}}
                <figure class="cl-upi">
                  <figcaption class="cl-upi-caption">{{view.bank.upi.scanLabel}}</figcaption>
                  {{#if view.bank.upi.note}}<p class="cl-upi-note">{{view.bank.upi.note}}</p>{{/if}}
                  <img class="cl-upi-qr" data-testid="upi-qr" src="{{view.bank.upi.qr}}" alt="{{view.bank.upi.label}} {{view.bank.upi.id}}" />
                  <p class="cl-upi-id cl-num">{{view.bank.upi.id}}</p>
                </figure>
              {{/if}}
            </section>
          {{/if}}
          </div>

          {{!-- Under Bank | UPI, each across the page (Refrens' native Classic): Attachments, then
                Additional Information. --}}
          {{#if view.attachments}}
            <section class="cl-card" data-testid="section" data-section="attachments">
              {{#if view.attachments.title}}<h2 class="cl-card-title" data-role="title">{{view.attachments.title}}</h2>{{/if}}
              <ol class="cl-attachments">
                {{#each view.attachments.files}}<li><a href="{{url}}" target="_blank" rel="noopener noreferrer" title="{{name}}">{{name}}</a></li>{{/each}}
              </ol>
            </section>
          {{/if}}

          {{#if view.additional}}
            <section class="cl-card" data-testid="section" data-section="additional">
              {{#if view.additional.title}}<h2 class="cl-card-title" data-role="title">{{view.additional.title}}</h2>{{/if}}
              <div class="cl-kv">
                {{#each view.additional.rows}}
                  <span class="cl-kv-label" data-role="ai-label">{{label}}</span>
                  <span class="cl-kv-value{{#if isDate}} cl-num{{/if}}" data-role="ai-value">{{#if isDate}}{{clDate value @root.invoice.ownerOffset}}{{else}}{{value}}{{/if}}</span>
                {{/each}}
              </div>
            </section>
          {{/if}}

          {{!-- Summaries last, after terms, notes and attachments (user request, 2026-10-27); rendered
                with their data, hidden while switched off (live toggles). --}}
          <section class="cl-card cl-widget-table" data-testid="section" data-section="hsn" data-ceres-hsn-summary{{#if view.hsn.hidden}} style="display: none;"{{/if}}>
            {{#if view.hsn.title}}<h3 class="cl-card-title" data-role="title">{{view.hsn.title}}</h3>{{/if}}
            {{> HsnSummaryTable (computeHsnSummary @root.invoice.items isIgst=(showIgst @root.invoice) isUtgst=(showUtgst @root.invoice)) }}
          </section>

          <section class="cl-card cl-widget-table" data-testid="section" data-section="tax-summary" data-ceres-tax-summary{{#if view.taxSummary.hidden}} style="display: none;"{{/if}}>
            {{#if view.taxSummary.title}}<h3 class="cl-card-title" data-role="title">{{view.taxSummary.title}}</h3>{{/if}}
            {{> TaxSummaryTable (computeTaxSummary @root.invoice.items isIgst=(showIgst @root.invoice) isUtgst=(showUtgst @root.invoice)) }}
          </section>

          {{#if view.stock}}
            <section class="cl-card cl-widget-table" data-testid="section" data-section="stock-summary" data-ceres-batch-summary{{#if view.stock.hidden}} style="display: none;"{{/if}}>
              {{#if view.stock.title}}<h3 class="cl-card-title" data-role="title">{{view.stock.title}}</h3>{{/if}}
              <div class="ceres-table-section">
                <table class="ceres-table cl-stock-table">
                  <thead><tr>{{#each view.stock.columns}}<th>{{label}}</th>{{/each}}</tr></thead>
                  <tbody>
                    {{#each view.stock.rows}}
                      <tr>{{#each this}}<td{{#if isNum}} class="cl-num" data-testid="num"{{/if}}>{{value}}</td>{{/each}}</tr>
                    {{/each}}
                  </tbody>
                </table>
              </div>
            </section>
          {{/if}}

          {{#if view.payments.show}}
            <section class="cl-card cl-widget-table" data-testid="section" data-section="payments" data-ceres-payment-table{{#if view.payments.hidden}} style="display: none;"{{/if}}>
              {{#if view.payments.title}}<h3 class="cl-card-title" data-role="title">{{view.payments.title}}</h3>{{/if}}
              <div class="ceres-table-section">
                <table class="ceres-table cl-payments-table">
                  <thead><tr>{{#each view.payments.columns}}<th>{{this}}</th>{{/each}}</tr></thead>
                  <tbody>
                    {{#each view.payments.rows}}
                      <tr data-testid="payment">
                        {{#each this}}
                          <td{{#unless isText}} class="cl-num"{{/unless}}>{{#if isDate}}{{clDate value @root.invoice.ownerOffset}}{{else}}{{value}}{{/if}}{{#if converted}}<span class="cl-payment-converted">{{converted}}</span>{{/if}}</td>
                        {{/each}}
                      </tr>
                    {{/each}}
                  </tbody>
                  {{#if view.payments.total}}
                    <tfoot><tr data-testid="payments-total">{{#each view.payments.total}}<td class="cl-num">{{value}}</td>{{/each}}</tr></tfoot>
                  {{/if}}
                </table>
              </div>
            </section>
          {{/if}}

          {{#if view.enquiry}}
            <p class="cl-enquiry" data-testid="enquiry" data-section="enquiry">{{view.enquiry.lead}}{{#if view.enquiry.email}} {{view.enquiry.emailLabel}} <strong class="cl-email">{{view.enquiry.email}}</strong>{{/if}}{{#if view.enquiry.phone}}{{#if view.enquiry.email}},{{/if}} {{view.enquiry.phoneLabel}} <strong class="cl-num">{{formatPhoneNumber view.enquiry.phone}}</strong>{{/if}}</p>
          {{/if}}

          {{> RefrensBranding @root.invoice}}
          {{!-- On the last page only: the content's last block, so in print the content before it
                goes over to a new page with it rather than leave it alone there. --}}
          {{#unless view.footerEveryPage}}
        <div class="{{#if view.serviceFooter}}no-dibella {{/if}}invoice-letterhead-footer cl-letterhead-footer{{#if view.footerEveryPage}} cl-footer-fixed{{/if}}{{#unless @root.invoice.letterHeadFooter}} is-empty{{/unless}}" data-ceres-page-footer data-ceres-page-policy="{{#if view.footerEveryPage}}all{{else}}last{{/if}}">
          {{#if @root.invoice.letterHeadFooter}}
            <img src="{{@root.invoice.letterHeadFooter}}" alt="Letterhead footer" data-ceres-height="letterhead-footer" />
          {{else}}
            <img alt="Letterhead footer" data-ceres-height="letterhead-footer" />
          {{/if}}
        </div>
          {{/unless}}
          </div>
        </td>
      </tr>
    </tbody>
  </table>

  {{!-- On every page: fixed to each printed page's foot (print rules), outside the frame. --}}
  {{#if view.footerEveryPage}}
  <div class="{{#if view.serviceFooter}}no-dibella {{/if}}invoice-letterhead-footer cl-letterhead-footer{{#if view.footerEveryPage}} cl-footer-fixed{{/if}}{{#unless @root.invoice.letterHeadFooter}} is-empty{{/unless}}" data-ceres-page-footer data-ceres-page-policy="{{#if view.footerEveryPage}}all{{else}}last{{/if}}">
    {{#if @root.invoice.letterHeadFooter}}
      <img src="{{@root.invoice.letterHeadFooter}}" alt="Letterhead footer" data-ceres-height="letterhead-footer" />
    {{else}}
      <img alt="Letterhead footer" data-ceres-height="letterhead-footer" />
    {{/if}}
  </div>
  {{/if}}
</div>
{{/with}}
