<div class="solvin-invoice">
  <div class="no-dibella invoice-letterhead{{#unless invoice.letterHead}} is-empty{{/unless}}">
    {{#if invoice.letterHead}}
      <img src="{{invoice.letterHead}}" alt="Letterhead" data-ceres-height="letterhead" />
    {{else}}
      <img alt="Letterhead" data-ceres-height="letterhead" />
    {{/if}}
  </div>

  <header class="solvin-title">
    <h1>{{#if invoice.invoiceTitle}}{{invoice.invoiceTitle}}{{else}}Invoice{{/if}}</h1>
    <div class="title-status">{{> InvoiceStatus invoice}}</div>
  </header>

  <section class="party-meta-grid">
    <div class="party-card">
      <p class="section-label">{{#if invoice.customLabels.billedBy}}{{invoice.customLabels.billedBy}}{{else}}Billed By{{/if}}</p>
      <p class="party-name">{{invoice.billedBy.name}}</p>
      <div class="address-lines">
        {{#each (partyAddressLines invoice.billedBy)}}<p>{{this}}</p>{{/each}}
      </div>
      {{#if invoice.billedBy.gstin}}<p class="id-line"><strong>GSTIN :</strong> {{invoice.billedBy.gstin}}</p>{{/if}}
      {{#if invoice.billedBy.panNumber}}<p class="id-line"><strong>PAN :</strong> {{invoice.billedBy.panNumber}}</p>{{/if}}
      {{#if invoice.billedBy.trnNumber}}<p class="id-line"><strong>TRN :</strong> {{invoice.billedBy.trnNumber}}</p>{{/if}}
      {{#if invoice.billedBy.tinNumber}}<p class="id-line"><strong>TIN :</strong> {{invoice.billedBy.tinNumber}}</p>{{/if}}
      {{#if invoice.billedBy.vatNumber}}<p class="id-line"><strong>{{#if invoice.billedBy.vatLabel}}{{invoice.billedBy.vatLabel}}{{else}}VAT{{/if}} :</strong> {{invoice.billedBy.vatNumber}}</p>{{/if}}
      {{#if invoice.billedBy.sstNumber}}<p class="id-line"><strong>SST :</strong> {{invoice.billedBy.sstNumber}}</p>{{/if}}
      {{#if invoice.billedBy.phone}}<p class="id-line"><strong>Phone :</strong> {{formatPhoneNumber invoice.billedBy.phone}}</p>{{/if}}
      {{#if invoice.billedBy.email}}<p class="id-line"><strong>Email :</strong> {{invoice.billedBy.email}}</p>{{/if}}
      {{#each invoice.billedBy.additionalIds}}<p class="id-line"><strong>{{label}} :</strong> {{value}}</p>{{/each}}
      {{#each invoice.billedBy.customFields}}<p class="id-line"><strong>{{label}} :</strong> {{value}}</p>{{/each}}
    </div>

    <div class="party-card">
      <p class="section-label">{{#if invoice.customLabels.billedTo}}{{invoice.customLabels.billedTo}}{{else}}Billed To{{/if}}</p>
      <p class="party-name">{{invoice.billedTo.name}}</p>
      <div class="address-lines">
        {{#each (partyAddressLines invoice.billedTo)}}<p>{{this}}</p>{{/each}}
      </div>
      {{#if invoice.billedTo.gstin}}<p class="id-line"><strong>GSTIN :</strong> {{invoice.billedTo.gstin}}</p>{{/if}}
      {{#if invoice.billedTo.panNumber}}<p class="id-line"><strong>PAN :</strong> {{invoice.billedTo.panNumber}}</p>{{/if}}
      {{#if invoice.billedTo.trnNumber}}<p class="id-line"><strong>TRN :</strong> {{invoice.billedTo.trnNumber}}</p>{{/if}}
      {{#if invoice.billedTo.tinNumber}}<p class="id-line"><strong>TIN :</strong> {{invoice.billedTo.tinNumber}}</p>{{/if}}
      {{#if invoice.billedTo.vatNumber}}<p class="id-line"><strong>{{#if invoice.billedTo.vatLabel}}{{invoice.billedTo.vatLabel}}{{else}}VAT{{/if}} :</strong> {{invoice.billedTo.vatNumber}}</p>{{/if}}
      {{#if invoice.billedTo.sstNumber}}<p class="id-line"><strong>SST :</strong> {{invoice.billedTo.sstNumber}}</p>{{/if}}
      {{#if invoice.billedTo.phone}}<p class="id-line"><strong>Phone :</strong> {{formatPhoneNumber invoice.billedTo.phone}}</p>{{/if}}
      {{#if invoice.billedTo.email}}<p class="id-line"><strong>Email :</strong> {{invoice.billedTo.email}}</p>{{/if}}
      {{#each invoice.billedTo.additionalIds}}<p class="id-line"><strong>{{label}} :</strong> {{value}}</p>{{/each}}
      {{#each invoice.billedTo.customFields}}<p class="id-line"><strong>{{label}} :</strong> {{value}}</p>{{/each}}
    </div>

    <div class="invoice-meta-table">
      <div class="meta-label">{{#if invoice.customLabels.invoiceNumber}}{{invoice.customLabels.invoiceNumber}}{{else}}Invoice No{{/if}}</div>
      <div>{{invoice.invoiceNumber}}</div>
      <div class="meta-label">{{#if invoice.customLabels.invoiceDate}}{{invoice.customLabels.invoiceDate}}{{else}}Invoice Date{{/if}}</div>
      <div>{{formateShortDateWithOffset invoice.invoiceDate invoice.ownerOffset}}</div>
      {{#if invoice.dueDate}}<div class="meta-label">{{#if invoice.customLabels.dueDate}}{{invoice.customLabels.dueDate}}{{else}}Due Date{{/if}}</div><div>{{formateShortDateWithOffset invoice.dueDate invoice.ownerOffset}}</div>{{/if}}
      {{#if mapped.visibility.showCountryOfSupply}}<div class="meta-label">{{#if invoice.customLabels.countryOfSupply}}{{invoice.customLabels.countryOfSupply}}{{else}}Country of Supply{{/if}}</div><div>{{formatCountryName invoice.countryOfSupply}}</div>{{/if}}
      {{#if mapped.visibility.showPlaceOfSupply}}<div class="meta-label">{{#if invoice.customLabels.placeOfSupply}}{{invoice.customLabels.placeOfSupply}}{{else}}Place of Supply{{/if}}</div><div>{{formatCountryName invoice.placeOfSupply}}</div>{{/if}}
      {{#if invoice.purchaseOrderNumber}}<div class="meta-label">{{#if invoice.customLabels.purchaseOrderNumber}}{{invoice.customLabels.purchaseOrderNumber}}{{else}}PO No{{/if}}</div><div>{{invoice.purchaseOrderNumber}}</div>{{/if}}
      {{#each invoice.customHeaders}}<div class="meta-label">{{label}}</div><div>{{value}}</div>{{/each}}
    </div>

    {{#if mapped.visibility.shippedTo}}
    <div class="shipped-card">
      <p class="section-label">{{#if invoice.customLabels.shippedTo}}{{invoice.customLabels.shippedTo}}{{else}}Shipped To{{/if}}</p>
      <p class="party-name">{{invoice.shippedTo.name}}</p>
      <div class="address-lines">
        {{#each (partyAddressLines invoice.shippedTo)}}<p>{{this}}</p>{{/each}}
      </div>
      {{#if invoice.shippedTo.gstin}}<p class="id-line"><strong>GSTIN :</strong> {{invoice.shippedTo.gstin}}</p>{{/if}}
      {{#if invoice.shippedTo.panNumber}}<p class="id-line"><strong>PAN :</strong> {{invoice.shippedTo.panNumber}}</p>{{/if}}
      {{#if invoice.shippedTo.phone}}<p class="id-line"><strong>Phone :</strong> {{formatPhoneNumber invoice.shippedTo.phone}}</p>{{/if}}
      {{#if invoice.shippedTo.email}}<p class="id-line"><strong>Email :</strong> {{invoice.shippedTo.email}}</p>{{/if}}
    </div>
    {{/if}}
  </section>

  <div class="items-table-wrap" data-column-count="{{mapped.visibility.visibleColumnCount}}">
  <table class="items-table">
    <colgroup>
      {{#each mapped.columns}}
        {{#unless isHidden}}<col class="{{className}}">{{/unless}}
      {{/each}}
    </colgroup>
    <thead>
      <tr>
        {{#each mapped.columns}}
          {{#unless isHidden}}<th class="{{className}} {{columnAlignmentClass this}}">{{label}}</th>{{/unless}}
        {{/each}}
      </tr>
    </thead>
    <tbody>
      {{#each invoice.items as |item|}}
      <tr class="item-row">
        {{#each ../mapped.columns as |column|}}
          {{#unless column.isHidden}}
          <td class="{{column.className}} {{columnAlignmentClass column}}">
            {{#if (isRowNumberColumn column)}}
              {{addOne @../index}}
            {{else if (isDescriptionColumn column ../../mapped.columns)}}
              <p class="item-name">{{item.name}}</p>
              <p class="item-codes">
                {{#if (showItemSku item ../../mapped.visibility.showSkuInName)}}<span><b>SKU</b> : {{itemSku item}}</span>{{/if}}
                {{#if ../../mapped.visibility.showSerialNumbersInDescription}}{{#if (itemSerialNumbers item)}}<span><b>Serial No.</b> : {{itemSerialNumbers item}}</span>{{/if}}{{/if}}
                {{#if ../../mapped.visibility.showInlineHsn}}{{#if (itemHsn item)}}<span><b>HSN/SAC</b> : {{formatSolvinHsn (itemHsn item)}}</span>{{/if}}{{/if}}
                {{#if ../../mapped.visibility.showInlineClassification}}{{#if item.classification}}<span>Classification : {{item.classification}}</span>{{/if}}{{/if}}
                {{#if ../../mapped.visibility.showUnitInName}}{{#if (itemUnit item ../../invoice)}}<span>Unit : {{itemUnit item ../../invoice}}</span>{{/if}}{{/if}}
              </p>
              {{#unless ../../mapped.visibility.isDescriptionFullWidth}}
                {{#if item.description}}
                  <div class="item-description">{{> MarkdownViewer (prepareMarkdownViewerData item.description) }}</div>
                {{/if}}
              {{/unless}}
              {{#if ../../invoice.purchaseOrderNumber}}<p class="item-po"><strong>{{#if ../../invoice.customLabels.purchaseOrderNumber}}{{../../invoice.customLabels.purchaseOrderNumber}}{{else}}PO No{{/if}} :</strong> {{../../invoice.purchaseOrderNumber}}</p>{{/if}}
            {{else if (isQuantityColumn column)}}
              {{quantityWithUnit item ../../invoice ../../mapped.visibility.showUnitInQuantity}}
            {{else if (isUnitColumn column)}}
              {{itemUnit item ../../invoice}}
            {{else if (isHsnColumn column)}}
              {{formatSolvinHsn (itemColumnValue item column)}}
            {{else if (isCurrencyColumn column)}}
              {{formatSolvinCurrency (itemCurrencyValue item column ../../invoice) ../../invoice}}
            {{else if (isRateColumn column)}}
              {{formatItemNumber item column ../../invoice}}%
            {{else if (isBooleanColumn column)}}
              {{formatBoolean (itemColumnValue item column)}}
            {{else if (isNumericColumn column)}}
              {{formatItemNumber item column ../../invoice}}
            {{else}}
              {{itemColumnValue item column}}
            {{/if}}
          </td>
          {{/unless}}
        {{/each}}
      </tr>
      {{#if ../mapped.visibility.isDescriptionFullWidth}}
        {{#if item.description}}
          <tr class="item-description-row">
            <td colspan="{{../mapped.visibility.visibleColumnCount}}">
              <div class="item-description">{{> MarkdownViewer (prepareMarkdownViewerData item.description) }}</div>
            </td>
          </tr>
        {{/if}}
      {{/if}}
      {{/each}}
      {{#if mapped.visibility.showTotalsRow}}<tr class="items-total-row">
        {{#each mapped.columns as |column|}}
          {{#unless column.isHidden}}
          <td class="{{column.className}} {{columnAlignmentClass column}}">
            {{#if (isDescriptionColumn column ../mapped.columns)}}
              Total
            {{else if (isQuantityColumn column)}}
              {{formatTotalQuantity ../invoice.items ../invoice}}
            {{else if (isAmountColumn column)}}
              {{formatSolvinCurrency ../totals.subTotal ../invoice}}
            {{else if (isTotalColumn column)}}
              {{formatSolvinCurrency ../invoice.finalTotal.total ../invoice}}
            {{else if (isRateColumn column)}}
              {{columnRateSummaryValue ../invoice.items column ../invoice}}
            {{else if column.summarise}}
              {{#if (isCurrencyColumn column)}}{{formatSolvinCurrency (columnSummaryValue ../invoice.items column) ../invoice}}{{else}}{{formatItemNumber (columnSummaryValue ../invoice.items column) column ../invoice}}{{/if}}
            {{/if}}
          </td>
          {{/unless}}
        {{/each}}
      </tr>{{/if}}
    </tbody>
  </table>
  </div>

  {{#if mapped.visibility.showTotals}}<div class="totals-wrap">
    <div class="totals-spacer"></div>
    <div class="totals-table">
      <div class="totals-label">{{display.labels.subTotal}}</div><div>{{formatSolvinCurrency totals.subTotal invoice}}</div>
      {{#if mapped.visibility.showTaxes}}{{#if mapped.visibility.showIgst}}
        <div class="totals-label">{{display.labels.igst}}</div><div>{{formatSolvinCurrency invoice.finalTotal.igst invoice}}</div>
      {{else}}
        <div class="totals-label">{{display.labels.cgst}}</div><div>{{formatSolvinCurrency invoice.finalTotal.cgst invoice}}</div>
        <div class="totals-label">{{#if mapped.visibility.isUtgst}}{{display.labels.utgst}}{{else}}{{display.labels.sgst}}{{/if}}</div>
        <div>{{#if mapped.visibility.isUtgst}}{{formatSolvinCurrency invoice.finalTotal.utgst invoice}}{{else}}{{formatSolvinCurrency invoice.finalTotal.sgst invoice}}{{/if}}</div>
      {{/if}}{{/if}}
      {{#each invoice.additionalCharges}}<div class="totals-label">{{#if label}}{{label}}{{else}}{{name}}{{/if}}</div><div>{{formatSolvinCurrency amount ../invoice}}</div>{{/each}}
      <div class="totals-label grand-total">{{display.labels.total}}<span data-ceres-currency-code{{#if mapped.visibility.hideCurrencyCode}} style="display: none;"{{/if}}>&nbsp;({{invoice.currency}})</span></div><div class="grand-total">{{formatSolvinCurrency invoice.finalTotal.total invoice}}</div>
      {{#if invoice.balance.tds}}<div class="totals-footer-label">{{display.labels.tdsAmountWithheld}}</div><div class="totals-footer-value">({{formatSolvinCurrency invoice.balance.tds invoice}})</div>{{/if}}
      {{#if invoice.balance.paid}}<div class="totals-footer-label">{{display.labels.amountPaid}}</div><div class="totals-footer-value">({{formatSolvinCurrency invoice.balance.paid invoice}})</div>{{/if}}
      {{#if invoice.balance.settledAmount}}<div class="totals-footer-label">{{display.labels.amountReceived}}</div><div class="totals-footer-value">{{formatSolvinCurrency invoice.balance.settledAmount invoice}}</div>{{/if}}
      {{#if invoice.balance.transactionCharge}}<div class="totals-footer-label">{{display.labels.transactionCharge}}</div><div class="totals-footer-value">{{formatSolvinCurrency invoice.balance.transactionCharge invoice}}</div>{{/if}}
      {{#if mapped.visibility.showDueAmount}}{{#if totals.dueAmount}}<div class="totals-footer-label">{{display.labels.dueAmount}}</div><div class="totals-footer-value">{{formatSolvinCurrency totals.dueAmount invoice}}</div>{{/if}}{{/if}}
    </div>
  </div>{{/if}}

  {{#if mapped.visibility.showTotalInWords}}<section class="amount-words-row">
    <strong>{{#if invoice.customLabels.totalInWords}}{{invoice.customLabels.totalInWords}}{{else}}Total In Words{{/if}}</strong>
    <span>{{#if invoice.customLabels.totalInWordsValue}}{{titleCaseWords invoice.customLabels.totalInWordsValue}}{{else}}{{amountInWords invoice.finalTotal.total}}{{/if}}</span>
  </section>{{/if}}

  {{#if mapped.visibility.showNotes}}<section class="notes-section">
    <h2>{{display.labels.notes}}</h2>
    <div class="notes-content">
      {{> MarkdownViewer (prepareMarkdownViewerData display.notes) }}
    </div>
  </section>{{/if}}

  <section class="lower-grid">
    {{#if mapped.visibility.showTerms}}<div class="terms-panel">
      <h2>{{#if invoice.customLabels.terms}}{{invoice.customLabels.terms}}{{else}}Terms and Conditions{{/if}}</h2>
      <ol>
        {{#each invoice.terms}}
          {{#each terms}}<li>{{this}}</li>{{/each}}
        {{/each}}
      </ol>
    </div>{{/if}}

    <div class="bank-panel">
      <h2>{{#if invoice.customLabels.bankDetails}}{{invoice.customLabels.bankDetails}}{{else}}Bank Details{{/if}}</h2>
      {{#if mapped.visibility.showBankAccount}}
      <div class="bank-table">
        <div>{{#if invoice.customLabels.accountName}}{{invoice.customLabels.accountName}}{{else}}Account Name{{/if}}</div><div>{{#if invoice.bankAccount.name}}{{invoice.bankAccount.name}}{{else}}{{invoice.bankAccount.accountHolderName}}{{/if}}</div>
        <div>{{#if invoice.customLabels.accountNumber}}{{invoice.customLabels.accountNumber}}{{else}}Account Number{{/if}}</div><div>{{#if invoice.bankAccount.accountNo}}{{invoice.bankAccount.accountNo}}{{else}}{{invoice.bankAccount.accountNumber}}{{/if}}</div>
        <div>{{#if invoice.customLabels.ifsc}}{{invoice.customLabels.ifsc}}{{else}}IFSC{{/if}}</div><div>{{#if invoice.bankAccount.ifsc}}{{invoice.bankAccount.ifsc}}{{else}}{{invoice.bankAccount.ifscCode}}{{/if}}</div>
        {{#if invoice.bankAccount.swift}}<div>{{#if invoice.customLabels.swift}}{{invoice.customLabels.swift}}{{else}}SWIFT{{/if}}</div><div>{{invoice.bankAccount.swift}}</div>{{/if}}
        {{#if invoice.bankAccount.accountType}}<div>{{#if invoice.customLabels.accountType}}{{invoice.customLabels.accountType}}{{else}}Account Type{{/if}}</div><div>{{invoice.bankAccount.accountType}}</div>{{/if}}
        <div>{{#if invoice.customLabels.bank}}{{invoice.customLabels.bank}}{{else}}Bank{{/if}}</div><div>{{#if invoice.bankAccount.bank}}{{invoice.bankAccount.bank}}{{else}}{{invoice.bankAccount.bankName}}{{/if}}</div>
        {{#each invoice.bankAccount.customFields}}<div>{{label}}</div><div>{{value}}</div>{{/each}}
      </div>
      {{/if}}
    </div>

    {{#if mapped.visibility.showHsnSummary}}<div class="hsn-panel" data-ceres-hsn-summary>
      {{> HsnSummaryTable (computeHsnSummary invoice.items isIgst=mapped.visibility.showIgst isUtgst=mapped.visibility.isUtgst) taxLabel=invoice.taxName }}
    </div>{{/if}}
  </section>

  <section class="signature-section">
    <div class="signature-box">
      <h2>For {{invoice.billedBy.name}}</h2>
      {{> CeresImage src=invoice.signature alt="Authorized signature" class="signature-image"}}
      <div class="signature-line"></div>
      <strong>{{#if invoice.customLabels.signature}}{{invoice.customLabels.signature}}{{else}}Authorized Signatory{{/if}}</strong>
    </div>
  </section>

  <div class="no-dibella invoice-letterhead-footer{{#unless invoice.letterHeadFooter}} is-empty{{/unless}}">
    {{#if invoice.letterHeadFooter}}
      <img src="{{invoice.letterHeadFooter}}" alt="Letterhead footer" data-ceres-height="letterhead-footer" />
    {{else}}
      <img alt="Letterhead footer" data-ceres-height="letterhead-footer" />
    {{/if}}
  </div>

  {{> RefrensBranding invoice}}
</div>
